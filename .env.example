DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
JWT_SECRET=paste-a-long-random-string-here
PORT=3000

# Guest phone verification. "console" prints the code in the terminal (free, for testing).
# Switch to "arkesel" to send real text messages (see docs/SMS-SETUP.md).
SMS_PROVIDER=console
ARKESEL_API_KEY=
ARKESEL_SENDER_ID=
